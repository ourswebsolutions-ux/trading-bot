# Build-time configuration for the desktop app (read by electron-vite; MAIN_VITE_* is visible to the main process only).
# Copy to .env (git-ignored) for local builds; set real values in your CI release job.

# Subscription API base URL. Must be https:// for packaged builds.
MAIN_VITE_API_BASE_URL=http://127.0.0.1:8787
# Ed25519 entitlement public key printed by the server (`npm run keys:generate` or server startup log).
MAIN_VITE_ENTITLEMENT_PUBLIC_KEY=

# Development-only (ignored by packaged builds):
# TRADEPILOT_DEV_INITIAL_PASSWORD=choose-a-local-dev-password
