# TradePilot subscription server configuration. Copy to .env (git-ignored) for local use.
# In production, inject these through your process manager / secret manager instead of a file.

NODE_ENV=development            # production enforces https PUBLIC_BASE_URL and a provisioned signing key
HOST=127.0.0.1
PORT=8787
# Public HTTPS origin of this server; used in the emailed Confirm Payment / Cancel Request links and their origin check.
PUBLIC_BASE_URL=http://127.0.0.1:8787
# Set to true when running behind a reverse proxy (nginx, Caddy, a load balancer) that sets X-Forwarded-For.
TRUST_PROXY=false
# Database, payment evidence and backups live here. Back up this directory.
DATA_DIR=./data

# Ed25519 key that signs entitlement tokens. Generate with `npm run keys:generate -w @tradepilot/server`.
# Required in production; development auto-generates one under DATA_DIR/keys.
ENTITLEMENT_PRIVATE_KEY_FILE=
ENTITLEMENT_TOKEN_TTL_HOURS=12

# Business address the client app emails each payment request to (with its Confirm Payment / Cancel Request links).
# Defaults to ourswebsolutions@gmail.com when empty.
ADMIN_NOTIFY_EMAIL=ourswebsolutions@gmail.com
# OPTIONAL extra payment details shown under the app's built-in instructions (e.g. bank or wallet details).
# Without them clients are told to email ADMIN_NOTIFY_EMAIL for payment details. Multi-line: use the _FILE variant.
PAYMENT_INSTRUCTIONS=
PAYMENT_INSTRUCTIONS_FILE=
# Lifetime of the single-use Confirm Payment / Cancel Request links (no administrator accounts are used).
REVIEW_LINK_TTL_HOURS=72

# REQUIRED for payments: hash of the review passphrase entered on the Confirm Payment / Cancel Request page.
# The client's app sends the request email, so the client also sees the links; the passphrase stops a client from
# approving their own request. Create it with:   npm run review:passphrase -w @tradepilot/server -- --write
# (writes only the scrypt hash here; never put the passphrase itself in any file). In production prefer the file form:
#   npm run review:passphrase -w @tradepilot/server -- --write /etc/tradepilot/review-passphrase.hash
REVIEW_PASSPHRASE_HASH=
REVIEW_PASSPHRASE_HASH_FILE=

# OPTIONAL server SMTP, only for emailing clients the approval/cancellation outcome (they are always notified in the
# app). Payment requests do NOT need it: the client's app sends them through the client's own SMTP connection.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false               # true = implicit TLS (465); false = STARTTLS
SMTP_REQUIRE_TLS=true           # refuse to send if STARTTLS is unavailable
SMTP_USER=
# Put the password in a file OUTSIDE the repository, readable only by the service user (chmod 600), e.g. /etc/tradepilot/smtp-password.
SMTP_PASSWORD_FILE=
# SMTP_PASSWORD also works but is visible in the process environment; never commit it.
SMTP_PASSWORD=
SMTP_FROM=

# Automatic online backups (VACUUM INTO + evidence copy). 0 disables the scheduler.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14
